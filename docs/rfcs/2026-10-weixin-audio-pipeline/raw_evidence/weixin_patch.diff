+async def _download_bytes(session: aiohttp.ClientSession, *, url: str, timeout_seconds: float = 120.0) -> bytes:
+    def _fetch_sync() -> bytes:
+        import subprocess
+        logger.warning("Weixin download starting via curl: url=%s timeout=%s", url[:120], timeout_seconds)
+        cmd = [
+            "curl", "-sSL",
+            "--connect-timeout", "15",
+            "-m", str(int(timeout_seconds)),
+            "-A", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
+            url
+        ]
+        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        if res.returncode == 0 and len(res.stdout) > 0:
+            logger.warning("Weixin download finished via curl: %d bytes", len(res.stdout))
+            return res.stdout
+        logger.warning("curl failed (exit %s, stderr=%r), trying urllib chunked...", res.returncode, res.stderr[:100])
+        import urllib.request, ssl, certifi
+        ctx = ssl.create_default_context(cafile=certifi.where())
+        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"})
+        with urllib.request.urlopen(req, timeout=timeout_seconds, context=ctx) as resp:
+            chunks = []
+            while True:
+                chunk = resp.read(65536)
+                if not chunk:
+                    break
+                chunks.append(chunk)
+            data = b"".join(chunks)
+            logger.warning("Weixin download finished via urllib: %d bytes", len(data))
+            return data
+    return await asyncio.to_thread(_fetch_sync)
 
 
